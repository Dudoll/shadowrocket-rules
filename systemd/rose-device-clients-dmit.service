[Unit]
Description=Reconcile device-specific VLESS clients after managed Xray rewrites
After=xray.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rose-reconcile-device-clients /etc/v2ray-agent/xray/conf/00-rose-dmit.json
User=root
Group=root
RuntimeDirectory=rose-device-clients
RuntimeDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/v2ray-agent/xray/conf /var/log/xray /run/lock
