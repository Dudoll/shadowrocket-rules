        "DOMAIN-SUFFIX,whatsapp.com,𝕏低延迟", "DOMAIN-SUFFIX,whatsapp.net,𝕏低延迟",
        # Telegram domains and networks.
        "DOMAIN-SUFFIX,telegram.org,✈️Telegram", "DOMAIN-SUFFIX,telegram.me,✈️Telegram", "DOMAIN-SUFFIX,t.me,✈️Telegram", "DOMAIN-SUFFIX,telesco.pe,✈️Telegram",
