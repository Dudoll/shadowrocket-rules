def tv_profile(proxies: list[dict]) -> dict:
    d = base_config(allow_lan=True)
    wanted = [
        "DMIT_CF_WS_443", "BAND_CF_WS_443",
        "DMIT_REALITY_IPv4_443", "BAND_REALITY_IPv4_443",
        "BAND_REALITY_IPv6_443", "DMIT_TLS_IPv6_443",
    ]
    by_name = {p["name"]: p for p in proxies}
    missing = [name for name in wanted if name not in by_name]
    if missing:
        raise RuntimeError(f"TV nodes missing from master: {missing}")
    d["proxies"] = [by_name[name] for name in wanted]
    test_url = "https://www.gstatic.com/generate_204"
    cdn = ["DMIT_CF_WS_443", "BAND_CF_WS_443"]
    direct = ["DMIT_REALITY_IPv4_443", "BAND_REALITY_IPv4_443", "BAND_REALITY_IPv6_443", "DMIT_TLS_IPv6_443"]
    d["proxy-groups"] = [
        {"name": "🛡️电视CDN", "type": "url-test", "proxies": cdn, "url": test_url, "interval": 60, "tolerance": 50, "lazy": False},
        {"name": "🚀电视直连兜底", "type": "url-test", "proxies": direct, "url": test_url, "interval": 120, "tolerance": 50, "lazy": False},
        {"name": "📺电视抗封锁", "type": "fallback", "proxies": ["🚀电视直连兜底", "🛡️电视CDN"], "url": test_url, "interval": 60, "lazy": False},
        {"name": "📺电视手动", "type": "select", "proxies": ["📺电视抗封锁", "🛡️电视CDN", "🚀电视直连兜底", *wanted, "DIRECT"]},
        {"name": "PROXY", "type": "select", "proxies": ["📺电视抗封锁", "📺电视手动", "DIRECT"]},
    ]
    d["rule-providers"] = {
        "private": rule_provider("private", "domain"),
        "direct": rule_provider("direct", "domain"),
        "cncidr": rule_provider("cncidr", "ipcidr"),
    }
    d["rules"] = [
        "DOMAIN-SUFFIX,youtube.com,📺电视抗封锁", "DOMAIN-SUFFIX,youtu.be,📺电视抗封锁", "DOMAIN-SUFFIX,googlevideo.com,📺电视抗封锁", "DOMAIN-SUFFIX,ytimg.com,📺电视抗封锁",
        "DOMAIN-SUFFIX,netflix.com,📺电视抗封锁", "DOMAIN-SUFFIX,nflxvideo.net,📺电视抗封锁", "DOMAIN-SUFFIX,nflximg.net,📺电视抗封锁",
        "DOMAIN-SUFFIX,disneyplus.com,📺电视抗封锁", "DOMAIN-SUFFIX,disney-plus.net,📺电视抗封锁", "DOMAIN-SUFFIX,bamgrid.com,📺电视抗封锁",
        "DOMAIN-SUFFIX,primevideo.com,📺电视抗封锁", "DOMAIN-SUFFIX,amazonvideo.com,📺电视抗封锁", "DOMAIN-SUFFIX,max.com,📺电视抗封锁", "DOMAIN-SUFFIX,hbomax.com,📺电视抗封锁",
        "RULE-SET,private,DIRECT", "RULE-SET,direct,DIRECT", "RULE-SET,cncidr,DIRECT", "GEOIP,CN,DIRECT", "MATCH,PROXY",
    ]
    return d


