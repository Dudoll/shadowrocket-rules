        "IP-CIDR6,2001:b28:f23c::/48,✈️Telegram,no-resolve", "IP-CIDR6,2001:b28:f23d::/48,✈️Telegram,no-resolve", "IP-CIDR6,2001:b28:f23f::/48,✈️Telegram,no-resolve", "IP-CIDR6,2001:67c:4e8::/48,✈️Telegram,no-resolve",
        # YouTube media and Google assets.
