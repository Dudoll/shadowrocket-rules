#!/usr/bin/env python3
"""Generate tailored personal and TV subscriptions from the live master nodes."""
from __future__ import annotations

import base64
import copy
import json
import os
import re
import tempfile
from pathlib import Path
from urllib.parse import unquote

import yaml

ENV = Path("/etc/rose-tailored-subscriptions.env")
MASTER_ROOT = Path("/etc/v2ray-agent/subscribe")
PUBLISH_ROOT = Path("/var/www/rose-rules")
RETIRED_NODE_NAMES = frozenset({"DMIT_REALITY_IPv4_8443", "VLESS_REALITY_Vision_DMIT_8443"})


def _node_prefix_name(prefix: str) -> str:
    return "DMIT" if prefix == "DMIT" else "Band"


def load_env(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        key, value = line.split("=", 1)
        values[key.strip()] = value.strip()
    required = {"MASTER_TOKEN", "XHTTP_TOKEN", "BAND_XHTTP_TOKEN", "PERSONAL_TOKEN", "TV_TOKEN"}
    missing = required - values.keys()
    if missing:
        raise RuntimeError(f"missing env keys: {sorted(missing)}")
    return values


def atomic_write(path: Path, text: str, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def decode_subscription(path: Path) -> list[str]:
    raw = path.read_text().strip()
    return [line.strip() for line in base64.b64decode(raw + "===").decode().splitlines() if line.strip()]


def node_name(link: str) -> str:
    return unquote(link.rsplit("#", 1)[-1]) if "#" in link else link


def dump_yaml(data: dict) -> str:
    return yaml.safe_dump(data, allow_unicode=True, sort_keys=False, width=1000)


def rule_provider(name: str, behavior: str) -> dict:
    return {
        "type": "http",
        "behavior": behavior,
        "url": f"https://cf.joelzt.org/clash-rules/{name}.txt",
        "path": f"./ruleset/{name}.yaml",
        "interval": 86400,
    }


def base_config(*, allow_lan: bool) -> dict:
    return {
        "mixed-port": 7890,
        "allow-lan": allow_lan,
        "mode": "rule",
        "log-level": "warning",
        "ipv6": True,
        "unified-delay": True,
        "tcp-concurrent": True,
        "profile": {"store-selected": True, "store-fake-ip": True},
        "dns": {
            "enable": True,
            "listen": "0.0.0.0:1053" if allow_lan else "127.0.0.1:1053",
            "ipv6": True,
            "enhanced-mode": "fake-ip",
            "fake-ip-range": "198.18.0.1/16",
            "fake-ip-filter": ["+.lan", "+.local", "time.*.com", "ntp.*.com"],
            "default-nameserver": ["223.5.5.5", "119.29.29.29"],
            "proxy-server-nameserver": ["https://223.5.5.5/dns-query", "https://1.12.12.12/dns-query"],
            "nameserver": ["https://223.5.5.5/dns-query", "https://1.12.12.12/dns-query"],
            "fallback": ["tls://1.1.1.1", "tls://8.8.8.8"],
            "fallback-filter": {"geoip": True, "geoip-code": "CN"},
            "respect-rules": True,
        },
    }


def personal_profile(master_token: str) -> dict:
    d = base_config(allow_lan=False)
    d["proxy-providers"] = {
        "rose": {
            "type": "http",
            "url": f"https://cf.joelzt.org/rose-all/clashMeta/{master_token}",
            "interval": 1800,
            "path": "./proxy_providers/rose.yaml",
            "health-check": {
                "enable": True,
                "url": "https://www.gstatic.com/generate_204",
                "interval": 120,
                "timeout": 5000,
                "lazy": False,
                "expected-status": 204,
            },
            "override": {"tfo": True, "udp": True},
        }
    }
    test_url = "https://www.gstatic.com/generate_204"
    direct_filter = r"^(DMIT_REALITY_IPv4_443|BAND_REALITY_IPv4_443|BAND_REALITY_IPv6_443|DMIT_TLS_IPv6_443)$"
    dmit_filter = r"^(DMIT_REALITY_IPv4_443|DMIT_TLS_IPv6_443)$"
    band_filter = r"^(BAND_REALITY_IPv4_443|BAND_REALITY_IPv6_443)$"
    cdn_filter = r"^(DMIT_CF_WS_443|BAND_CF_WS_443)$"
    dmit_cdn_filter = r"^DMIT_CF_WS_443$"
    d["proxy-groups"] = [
        {"name": "⚡直连低延迟", "type": "url-test", "use": ["rose"], "filter": direct_filter, "url": test_url, "interval": 180, "tolerance": 30, "lazy": False},
        {"name": "🤖DMIT-AI", "type": "url-test", "use": ["rose"], "filter": dmit_filter, "url": test_url, "interval": 180, "tolerance": 30, "lazy": False},
        {"name": "📡Band直连", "type": "url-test", "use": ["rose"], "filter": band_filter, "url": test_url, "interval": 180, "tolerance": 30, "lazy": False},
        {"name": "🛡️CDN抗封锁", "type": "url-test", "use": ["rose"], "filter": cdn_filter, "url": test_url, "interval": 120, "tolerance": 50, "lazy": False},
        {"name": "🤖DMIT-CDN", "type": "url-test", "use": ["rose"], "filter": dmit_cdn_filter, "url": test_url, "interval": 120, "tolerance": 50, "lazy": False},
        {"name": "𝕏低延迟", "type": "fallback", "proxies": ["⚡直连低延迟", "🛡️CDN抗封锁"], "url": test_url, "interval": 60, "lazy": False},
        {"name": "🤖AI稳定", "type": "fallback", "proxies": ["🤖DMIT-AI", "🤖DMIT-CDN"], "url": test_url, "interval": 60, "lazy": False},
        {"name": "▶️YouTube稳定", "type": "fallback", "proxies": ["⚡直连低延迟", "🛡️CDN抗封锁"], "url": test_url, "interval": 60, "lazy": False},
        {"name": "✈️Telegram", "type": "fallback", "proxies": ["⚡直连低延迟", "🛡️CDN抗封锁"], "url": test_url, "interval": 60, "lazy": False},
        {"name": "🌍默认代理", "type": "fallback", "proxies": ["⚡直连低延迟", "🛡️CDN抗封锁"], "url": test_url, "interval": 60, "lazy": False},
        {"name": "🧭手动选择", "type": "select", "proxies": ["𝕏低延迟", "🤖AI稳定", "▶️YouTube稳定", "✈️Telegram", "⚡直连低延迟", "🛡️CDN抗封锁", "DIRECT"], "use": ["rose"]},
        {"name": "PROXY", "type": "select", "proxies": ["🌍默认代理", "𝕏低延迟", "🤖AI稳定", "▶️YouTube稳定", "🛡️CDN抗封锁", "🧭手动选择", "DIRECT"]},
