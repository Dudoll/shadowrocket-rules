RULE-SET,https://cf.joelzt.org/shadowrocket-rules/cncidr.txt,DIRECT
GEOIP,CN,DIRECT
FINAL,PROXY,dns-failed
"""


def main() -> None:
    env = load_env(ENV)
    master_token = env["MASTER_TOKEN"]
    xhttp_token = env["XHTTP_TOKEN"]
    band_xhttp_token = env["BAND_XHTTP_TOKEN"]
    master_yaml_path = MASTER_ROOT / "clashMeta" / master_token
    master_yaml = yaml.safe_load(master_yaml_path.read_text())
    proxies = master_yaml["proxies"]

    # One Shadowrocket subscription containing all direct, CDN WS, and XHTTP fallbacks.
    links = (
        decode_subscription(MASTER_ROOT / "default" / master_token)
        + decode_subscription(MASTER_ROOT / "default" / xhttp_token)
        + decode_subscription(MASTER_ROOT / "default" / band_xhttp_token)
    )
    by_name = {node_name(link): link for link in links}
    ordered_names = [
        "DMIT_REALITY_IPv4_443", "BAND_REALITY_IPv4_443", "BAND_REALITY_IPv6_443",
        "DMIT_TLS_IPv6_443",
        "DMIT_XHTTP_H2_443", "BAND_XHTTP_H2_443", "DMIT_CF_WS_443", "BAND_CF_WS_443",
        "DMIT_XHTTP_H3_443", "BAND_XHTTP_H3_443",
    ]
    missing = [name for name in ordered_names if name not in by_name]
    if missing:
        raise RuntimeError(f"personal subscription nodes missing: {missing}")
    combined = "\n".join(by_name[name] for name in ordered_names) + "\n"
    encoded = base64.b64encode(combined.encode()).decode() + "\n"

    personal_token = env["PERSONAL_TOKEN"]
    tv_token = env["TV_TOKEN"]
    atomic_write(PUBLISH_ROOT / "split/all/default" / personal_token, encoded)
    atomic_write(PUBLISH_ROOT / "split/all/clashMetaProfiles" / personal_token, dump_yaml(personal_profile(master_token)))
    atomic_write(PUBLISH_ROOT / "split/tv/clashMetaProfiles" / tv_token, dump_yaml(tv_profile(proxies)))
    atomic_write(PUBLISH_ROOT / "shadowrocket-personal.conf", shadowrocket_config())

    print(f"generated personal default + Clash profile token={personal_token[:6]}…")
    print(f"generated self-contained TV Clash profile token={tv_token[:6]}…")


if __name__ == "__main__":
    main()
