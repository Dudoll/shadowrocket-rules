AI稳定 = fallback,MOBILE_DMIT_REALITY_IPv4_443,MOBILE_DMIT_TLS_IPv6_443,MOBILE_DMIT_XHTTP_H2_443,MOBILE_DMIT_CF_WS_443,MOBILE_DMIT_XHTTP_H3_443,url=https://www.gstatic.com/generate_204,interval=60,timeout=10
YouTube稳定 = fallback,低延迟直连,CDN抗封锁,url=https://www.gstatic.com/generate_204,interval=60,timeout=10
Telegram稳定 = fallback,低延迟直连,CDN抗封锁,url=https://www.gstatic.com/generate_204,interval=60,timeout=8
PROXY = select,X低延迟,AI稳定,YouTube稳定,Telegram稳定,低延迟直连,CDN抗封锁,DIRECT

[Rule]
# Local/system traffic and ad rejection must win before broad AI/social/video rules.
RULE-SET,SYSTEM,DIRECT
