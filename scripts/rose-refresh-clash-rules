#!/usr/bin/env bash
set -Eeuo pipefail

DEST=/var/www/rose-rules/clash-rules
SHADOW_DEST=/var/www/rose-rules/shadowrocket-rules
FILES=(icloud private apple cncidr proxy direct reject)
BASE=https://raw.githubusercontent.com/Loyalsoldier/clash-rules/release
TMP=$(/usr/bin/mktemp -d)
trap '/usr/bin/rm -rf "$TMP"' EXIT

for name in "${FILES[@]}"; do
  /usr/bin/curl -fsSL --retry 4 --retry-all-errors --connect-timeout 10 --max-time 120 \
    "$BASE/$name.txt" -o "$TMP/$name.txt"
  /usr/bin/grep -q '^payload:' "$TMP/$name.txt"
  test "$(/usr/bin/stat -c %s "$TMP/$name.txt")" -gt 100
  /usr/bin/chmod 0644 "$TMP/$name.txt"
done

/usr/bin/install -d -o root -g root -m 0755 "$DEST"
for name in "${FILES[@]}"; do
  /usr/bin/install -o root -g root -m 0644 "$TMP/$name.txt" "$DEST/$name.txt.new"
  /usr/bin/mv -f "$DEST/$name.txt.new" "$DEST/$name.txt"
done

/usr/bin/install -d -o root -g root -m 0755 "$SHADOW_DEST"
/usr/bin/python3 /usr/local/sbin/rose-convert-clash-rules.py \
  --source-dir "$DEST" \
  --destination-dir "$SHADOW_DEST"

# The MIHOMO custom lists and AWAvenue Ads Rules are now consumed as remote
# rule-providers directly in the Rose Computer subscription; the local cache
# is no longer required for generation.

# Generate tailored device subscriptions first, then mirror every generated
# artifact—including the new Shadowrocket rules—to Band.
/usr/bin/systemctl start rose-tailored-subscriptions.service
/usr/bin/systemctl start rose-subscription-sync.service
